        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="is_target = str(target).strip().lower() == 'true'&amp;#10;pressed = bool(key_resp_trial.keys)&amp;#10;if pressed:&amp;#10;    outlet.push_sample([&quot;key_press&quot;])&amp;#10;if is_target:&amp;#10;    if pressed:&amp;#10;        n_hits += 1&amp;#10;    else:&amp;#10;        n_misses += 1&amp;#10;else:&amp;#10;    if pressed:&amp;#10;        n_fa += 1&amp;#10;    else:&amp;#10;        n_cr += 1&amp;#10;thisExp.addData('correct', int(pressed == is_target))&amp;#10;thisExp.addData('block', block)&amp;#10;thisExp.addData('N', N)&amp;#10;thisExp.addData('rt', key_resp_trial.rt if pressed else None)&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
