      <KeyboardComponent name="key_resp_welcome" plugin="None">
        <Param val="'space'" valType="list" updates="constant" name="allowedKeys"/>
        <Param val="" valType="str" updates="constant" name="correctAns"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="True" valType="bool" updates="constant" name="discard previous"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="True" valType="bool" updates="constant" name="forceEndRoutine"/>
        <Param val="key_resp_welcome" valType="code" updates="None" name="name"/>
        <Param val="press" valType="str" updates="constant" name="registerOn"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="last key" valType="str" updates="constant" name="store"/>
        <Param val="False" valType="bool" updates="constant" name="storeCorrect"/>
        <Param val="True" valType="bool" updates="constant" name="syncScreenRefresh"/>
      </KeyboardComponent>
      <CodeComponent name="code_welcome" plugin="None">
        <Param val="import hashlib&amp;#10;import psychopy.logging as log&amp;#10;from pathlib import Path&amp;#10;from pylsl import StreamInfo, StreamOutlet&amp;#10;&amp;#10;# Setup LSL outlet for syncing trial events with external lab devices&amp;#10;# (EEG, heart-rate band, etc.). Markers are simple strings.&amp;#10;log.info(&quot;Creating LSL streams&quot;)&amp;#10;info = StreamInfo(&quot;Psychopy&quot;, &quot;Markers&quot;, 1, 0, &quot;string&quot;, &quot;PsychopyUUID0001&quot;)&amp;#10;outlet = StreamOutlet(info)&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="psychoJS.window.mouseVisible = false;&amp;#10;" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="n_blocks = int(expInfo['nBlocks'])&amp;#10;top_n = int(expInfo['topN'])&amp;#10;assert 1 &lt;= n_blocks &lt;= 10, &quot;nBlocks must be between 1 and 10&quot;&amp;#10;assert 2 &lt;= top_n &lt;= 5, &quot;topN must be between 2 and 5&quot;&amp;#10;&amp;#10;# Numeric participant IDs (e.g. &quot;042&quot;) map directly to schedules/042.csv.&amp;#10;# Non-numeric IDs (e.g. &quot;pilot&quot;) hash deterministically to a 3-digit code.&amp;#10;participant_str = str(expInfo['participant'])&amp;#10;try:&amp;#10;    participant_id = int(participant_str)&amp;#10;    assert 0 &lt;= participant_id &lt;= 999, &quot;numeric participant must be 0..999&quot;&amp;#10;except ValueError:&amp;#10;    h = hashlib.md5(participant_str.encode()).hexdigest()&amp;#10;    participant_id = int(h, 16) % 1000&amp;#10;&amp;#10;cap = top_n&amp;#10;schedule_file = f&quot;schedules/{participant_id:03d}.csv&quot;&amp;#10;assert Path(schedule_file).exists(), (&amp;#10;    f&quot;missing {schedule_file}; run prerandomize.py first&quot;&amp;#10;)&amp;#10;&amp;#10;# Initialize loop-iteration vars at module scope (via globals()) so the&amp;#10;# shared `fix` routine's skipIf (`N &gt; cap or block &gt; n_blocks`) evaluates&amp;#10;# False during the pre-schedule flow (welcome, intro, training) AND so&amp;#10;# scheduleLoop's per-row injection (`globals()[paramName] = ...`) actually&amp;#10;# updates the same names — assigning `block = 0` directly here would make&amp;#10;# `block`/`N` locals to the generated `run()` and shadow the loop values.&amp;#10;globals()['block'] = 0&amp;#10;globals()['N'] = 0&amp;#10;&amp;#10;n_hits = n_misses = n_fa = n_cr = 0&amp;#10;&amp;#10;# Per-training accumulators, cleared at the start of each pass through&amp;#10;# a train{N}_repeat iteration (see code_intro_train{N}).&amp;#10;train_letters_log = []&amp;#10;train_target_log = []&amp;#10;train_pressed_log = []&amp;#10;train_correct_log = []&amp;#10;train_n_hits = train_n_misses = train_n_fa = train_n_cr = 0&amp;#10;&amp;#10;outlet.push_sample([&quot;begin_experiment&quot;])&amp;#10;# duplicate-on-purpose: PsychoPy bug where Settings.Show mouse=False alone leaks the cursor.&amp;#10;win.mouseVisible = False" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_welcome" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
