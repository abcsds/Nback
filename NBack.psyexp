        <Param val="total_train = train_n_hits + train_n_misses + train_n_fa + train_n_cr&amp;#10;correct_train = train_n_hits + train_n_cr&amp;#10;wrong_train = train_n_misses + train_n_fa&amp;#10;correct_pct = (100 * correct_train / total_train) if total_train else 0&amp;#10;should_repeat = train_n_hits == 0&amp;#10;&amp;#10;def _cell(s):&amp;#10;    return f&quot;{str(s):&gt;2}&quot;&amp;#10;&amp;#10;letters_row = &quot; &quot;.join(_cell(L) for L in train_letters_log)&amp;#10;type_row    = &quot; &quot;.join(_cell(&quot;T&quot; if t else &quot;&quot;) for t in train_target_log)&amp;#10;click_row   = &quot; &quot;.join(_cell(&quot;C&quot; if p else &quot;&quot;) for p in train_pressed_log)&amp;#10;result_row  = &quot; &quot;.join(_cell(&quot;OK&quot; if c else &quot;X&quot;) for c in train_correct_log)&amp;#10;&amp;#10;grid_text = (&amp;#10;    f&quot;Letra:    {letters_row}\n&quot;&amp;#10;    f&quot;Objetivo: {type_row}\n&quot;&amp;#10;    f&quot;Tu resp.: {click_row}\n&quot;&amp;#10;    f&quot;Resultado:{result_row}&quot;&amp;#10;)&amp;#10;&amp;#10;verdict = &quot;Repetiremos el entrenamiento.&quot; if should_repeat else &quot;¡Bien hecho!&quot;&amp;#10;score_text = f&quot;Aciertos: {correct_train}/{total_train}  ({correct_pct:.0f}%)\n{verdict}&quot;&amp;#10;&amp;#10;text_feedback_train3.alignText = 'left'&amp;#10;text_feedback_train3.setText(grid_text)&amp;#10;text_feedback_train3_score.setText(score_text)&amp;#10;text_feedback_train3_score.color = 'darkred' if should_repeat else 'darkgreen'&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
